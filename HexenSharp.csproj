<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HexenSharp</RootNamespace>
    <AssemblyName>HexenSharp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <Compile Remove="server/**/*.cs" />
    <Compile Remove="web/**" />
  </ItemGroup>

  <!-- the optional Blender-rendered art pack (tools/blender/build_scifi_assets.py) -->
  <ItemGroup>
    <EmbeddedResource Include="assets/scifi/**/*.png" LogicalName="assets/scifi/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
