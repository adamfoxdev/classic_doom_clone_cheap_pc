<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The browser version. It compiles the very same game code as the desktop build (everything in src/ but the
    desktop's window, input and audio, which WebHost.cs and wwwroot/ stand in for), so the two never drift apart:
    a change to the game is a change to both.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HexenSharp</RootNamespace>
    <AssemblyName>HexenSharp.Web</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- saves, replays and the network use reflection-based JSON; only the framework is trimmed, never the game -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../src/**/*.cs" Exclude="../src/Program.cs;../src/Audio.cs" />
    <EmbeddedResource Include="../assets/scifi/**/*.png" LogicalName="assets/scifi/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
